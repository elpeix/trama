{
  "version": 1,
  "meta": {
    "title": "Siren echo",
    "description": "A siren made with an LFO, and an echo"
  },
  "tempo": 120,
  "nodes": [
    {
      "id": "lfo-1",
      "type": "lfo",
      "position": {
        "x": 40,
        "y": 40
      },
      "params": {
        "waveform": "sawtooth",
        "sync": "free",
        "rate": 2
      }
    },
    {
      "id": "keyboard-2",
      "type": "keyboard",
      "position": {
        "x": 40,
        "y": 320
      },
      "params": {
        "transpose": 0
      }
    },
    {
      "id": "oscillator-3",
      "type": "oscillator",
      "position": {
        "x": 360,
        "y": 40
      },
      "params": {
        "waveform": "sine",
        "mode": "free",
        "frequency": 660,
        "detune": 0
      }
    },
    {
      "id": "envelope-4",
      "type": "envelope",
      "position": {
        "x": 360,
        "y": 320
      },
      "params": {
        "attack": 0.01,
        "decay": 0.3,
        "sustain": 0.6,
        "release": 0.5,
        "curve": "linear",
        "spread": 0.01
      }
    },
    {
      "id": "gain-5",
      "type": "gain",
      "position": {
        "x": 680,
        "y": 40
      },
      "params": {
        "gain": 0
      }
    },
    {
      "id": "delay-6",
      "type": "delay",
      "position": {
        "x": 1000,
        "y": 40
      },
      "params": {
        "sync": "free",
        "time": 0.3,
        "feedback": 0.4,
        "mix": 0.5
      }
    },
    {
      "id": "output-7",
      "type": "output",
      "position": {
        "x": 1320,
        "y": 40
      },
      "params": {
        "volume": 1,
        "limiter": "on"
      }
    }
  ],
  "connections": [
    {
      "id": "lfo-1:out->oscillator-3:frequency",
      "source": {
        "nodeId": "lfo-1",
        "port": "out"
      },
      "target": {
        "nodeId": "oscillator-3",
        "port": "frequency"
      },
      "amount": -0.25
    },
    {
      "id": "keyboard-2:pitch->oscillator-3:detune",
      "source": {
        "nodeId": "keyboard-2",
        "port": "pitch"
      },
      "target": {
        "nodeId": "oscillator-3",
        "port": "detune"
      }
    },
    {
      "id": "keyboard-2:gate->envelope-4:gate",
      "source": {
        "nodeId": "keyboard-2",
        "port": "gate"
      },
      "target": {
        "nodeId": "envelope-4",
        "port": "gate"
      }
    },
    {
      "id": "oscillator-3:audio->gain-5:audio",
      "source": {
        "nodeId": "oscillator-3",
        "port": "audio"
      },
      "target": {
        "nodeId": "gain-5",
        "port": "audio"
      }
    },
    {
      "id": "envelope-4:out->gain-5:gain",
      "source": {
        "nodeId": "envelope-4",
        "port": "out"
      },
      "target": {
        "nodeId": "gain-5",
        "port": "gain"
      }
    },
    {
      "id": "gain-5:audio->delay-6:audio",
      "source": {
        "nodeId": "gain-5",
        "port": "audio"
      },
      "target": {
        "nodeId": "delay-6",
        "port": "audio"
      }
    },
    {
      "id": "delay-6:audio->output-7:audio",
      "source": {
        "nodeId": "delay-6",
        "port": "audio"
      },
      "target": {
        "nodeId": "output-7",
        "port": "audio"
      }
    }
  ]
}
